{
  "name": "@commerce-platform/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:relay": "RUNTIME_ROLE=relay node dist/main.js",
    "start:worker": "RUNTIME_ROLE=worker node dist/main.js",
    "start:watch": "node --watch dist/main.js",
    "dev": "pnpm build && concurrently -k -n TSC,API -c cyan,green \"pnpm build:watch\" \"pnpm start:watch\"",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/api/src"
  },
  "dependencies": {
    "@commerce-platform/contracts": "workspace:*",
    "@commerce-platform/database": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commerce-platform/testing": "workspace:*"
  }
}
