{
  "name": "@commerce-platform/database",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle",
    "src",
    "drizzle.config.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "lint": "eslint src --ext .ts",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/database/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
