{
  "name": "@commerce-platform/testing",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --config ../../vitest.config.ts packages/testing/src --passWithNoTests",
    "test:integration": "vitest run --config ../../vitest.integration.config.ts packages/testing/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@commerce-platform/database": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "testcontainers": "^12.1.0"
  }
}
