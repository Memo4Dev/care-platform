{
  "info": {
    "name": "Care Platform API — Staging",
    "description": "M1 + M2 (Catalog & Pricing) staging environment collection.\n\nBase URL: https://api.care-systems.site\n\nAll endpoints require Bearer JWT unless noted.\n\nMutation requests (POST/PUT/PATCH/DELETE) automatically get an Idempotency-Key header.\n\nM2 adds Tenant Admin endpoints for Catalog and Pricing management under /api/v1/admin/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(pm.request.method)) {",
          "    pm.request.headers.add({",
          "        key: 'Idempotency-Key',",
          "        value: crypto.randomUUID()",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.care-systems.site" },
    { "key": "metricsToken", "value": "w9MqY6C5sTatgG_DqPuGlt9uMSQEe6G-pfIodKWHKpI" },
    { "key": "platformToken", "value": "PASTE_FRESH_JWT_HERE" },
    { "key": "tenantToken", "value": "PASTE_FRESH_TENANT_JWT_HERE" },
    { "key": "tenantId", "value": "6ba7b812-9dad-11d1-80b4-00c04fd430c8" },
    { "key": "planId", "value": "01a0396d-fa03-7457-948e-a602bbaa8a8a" }
  ],
