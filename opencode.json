{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git merge *",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
